  m_text: "\u039F \u03B1\u03C3\u03B8\u03B5\u03BD\u03AE\u03C2 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03B9
    \u03BE\u03B1\u03C6\u03BD\u03B9\u03BA\u03AE \u03B4\u03CD\u03C3\u03C0\u03BD\u03BF\u03B9\u03B1,
    \u03AD\u03BD\u03C4\u03BF\u03BD\u03B7 \u03BA\u03C5\u03AC\u03BD\u03C9\u03C3\u03B7
    (\u03BC\u03C0\u03BB\u03B5 \u03C7\u03C1\u03C9\u03BC\u03B1\u03C4\u03B9\u03C3\u03BC\u03CC\u03C2
    \u03C3\u03C4\u03B1 \u03C7\u03B5\u03AF\u03BB\u03B7) \u03BA\u03B1\u03B9 \u03C4\u03B1\u03C7\u03CD\u03C0\u03BD\u03BF\u03B9\u03B1.\n\n(\u03BC\u03B7\u03BD\u03C5\u03BC\u03B1
